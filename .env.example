# Copy to .env and fill in. .env is gitignored. No spaces around "=".

# LLM key - the one matching llm.provider in config.yaml
XAI_API_KEY=            # provider: xai  - Grok, key starts "xai-"  (console.x.ai)
# GROQ_API_KEY=         # provider: groq - Groq, key starts "gsk_"  (console.groq.com)
# XKIRO_API_KEY=        # provider: xkiro
# OPENROUTER_API_KEY=   # provider: openrouter
# CURSOR_API_KEY=       # provider: cursor, and bench-models.sh
# TYPESAFE_API_KEY=     # provider: jev

# Gmail App Password for sending alerts/digests (myaccount.google.com/apppasswords)
JOBRADAR_SMTP_PASSWORD=
